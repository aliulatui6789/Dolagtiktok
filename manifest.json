{
  "manifest_version": 3,
  "name": "TikTok Auto-Fix & Following Helper",
  "short_name": "TT Auto-Fix",
  "version": "1.1.0",
  "description": "Recovers from TikTok's \"Something went wrong\" error, auto-scrolls Following/Followers lists, and fixes stale cached \"Follow\" buttons after a confirmed follow.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage",
    "activeTab",
    "declarativeNetRequest",
    "cookies",
    "scripting"
  ],
  "host_permissions": [
    "*://*.tiktok.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "tiktok_no_cache",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "interceptor.js",
        "page-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "*://*.tiktok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TikTok Auto-Fix & Following Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
