{
  "manifest_version": 3,
  "name": "TikTok Auto-Fix & Following Helper",
  "short_name": "TT Auto-Fix",
  "version": "1.0.0",
  "description": "Automatically recovers from TikTok's \"Something went wrong\" error and auto-scrolls Following/Followers lists.",
  "minimum_chrome_version": "111",
  "permissions": ["storage", "cookies", "activeTab", "scripting"],
  "host_permissions": ["*://*.tiktok.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://*.tiktok.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "TikTok Auto-Fix & Following Helper",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
